### URL: https://www-dev.springfield.moz.works/get/

# Variables:
#   $partner (string) - a company name, e.g. Acme
# $partner is a company name and stays in its original form. If your language changes a name’s ending after ‘from’, rephrase the sentence so the name can stay unchanged.
partner-download-language-not-available = This { -brand-name-firefox } download from { $partner } isn’t available in your language. You can still download { -brand-name-firefox } using the button below.

# Variables:
#   $partner (string) - a company name, e.g. Acme
# $partner is a company name and stays in its original form. If your language changes a name’s ending after ‘from’, rephrase the sentence so the name can stay unchanged.
partner-download-device-not-available = This { -brand-name-firefox } download from { $partner } isn’t available for your device. You can still download { -brand-name-firefox } using the button below.

# firefox.com is a web address. Don’t translate it.
partner-download-already-using-firefox = You’re already using { -brand-name-firefox }. Continue to firefox.com to see what’s new.

# firefox.com is a web address. Don’t translate it.
partner-download-continue = Continue to firefox.com

# Variables:
#   $partner (string) - a company name, e.g. Acme
# $partner is a company name and stays in its original form. If your language changes a name’s ending after ‘from’, rephrase the sentence so the name can stay unchanged.
partner-download-link-visit = Visit { $partner }

# Button text for a link to a company’s page.
partner-download-link-learn-more = Learn more
